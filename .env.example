# Set to "true" to allow service_restart (default: disabled)
ALLOW_WRITE_ACTIONS=false

# AWS region for ec2_status (defaults to ap-south-1)
AWS_REGION=ap-south-1

# AWS credentials are picked up from the standard chain
# (env vars, ~/.aws/credentials, or IAM role) — uncomment if needed:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
